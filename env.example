# Скопируйте в .env и заполните
# Токен бота из @BotFather (нужен только для входа через Telegram)
BOT_TOKEN=

# Длинный случайный секрет для подписи JWT-сессий
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Доступ к админке. Веб-логины через запятую (в нижнем регистре).
ADMIN_USERS=ironmax
# И/или Telegram ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_TELEGRAM_IDS=
